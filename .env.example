# Copy this file to .env and fill in the values. .env is gitignored.

# ── Tinker / Weights & Biases / Hugging Face ──
TINKER_API_KEY=
WANDB_API_KEY=
HF_TOKEN=

# ── Azure OpenAI / Cohere Reranker ──
# AZURE_API_KEY is the canonical resource key the client code reads.
# The three *_API_KEY variants below are alternate names for the same value
# (operator's reference card style); set them to the same string.
AZURE_API_KEY=

# Azure OpenAI LLM (e.g. gpt-5.4 deployment)
# Foundry-projects path — the API version is IN the URL, not a query param.
AZURE_OPENAI_LLM_BASE_URL=
AZURE_OPENAI_LLM_API_KEY=
AZURE_OPENAI_LLM_DEPLOYMENT=
AZURE_OPENAI_LLM_API_VERSION=
LLM_MAX_COMPLETION_TOKENS=8192
LLM_TEMPERATURE=1.0

# Azure OpenAI Embedding (e.g. text-embedding-3-small)
# Legacy /openai/v1 path — different from the LLM base URL.
AZURE_OPENAI_EMBEDDING_BASE_URL=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_API_VERSION=
AZURE_OPENAI_EMBEDDING_DIMENSION=1536

# Azure Cohere Reranker (v4.0 fast)
# Path is appended to the base URL: full POST URL = BASE + PATH.
AZURE_RERANKER_BASE_URL=
AZURE_RERANKER_API_KEY=
AZURE_RERANKER_DEPLOYMENT=
AZURE_RERANKER_PATH=
AZURE_RERANKER_MIN_INTERVAL_S=15.0
AZURE_RERANKER_MAX_DOC_CHARS=200
