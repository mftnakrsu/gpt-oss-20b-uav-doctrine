# --- Python / build ---
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# --- Virtual envs / package managers ---
.venv/

# --- Project outputs (regenerable; never tracked) ---
data/interim/
# Track the final Q&A splits (useful downstream artifact); ignore everything
# else regenerable under data/processed/ (e.g. the empty Phase B scenario dir).
data/processed/*
!data/processed/qa/
!data/processed/qa/**
# Legacy interim subdirs from the ingest phase
data/clean/
data/chunked/
data/sft/
data/eval/
checkpoints/
outputs/
logs/
wandb/
mlruns/
*.ckpt
**/.archive_url

# --- Secrets ---
.env
.env.local

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store

# --- Tooling state ---
.claude/
# Agent-internal cross-session memory files (never part of the public repo)
feedback_*.md

# --- Explicitly tracked ---
# data/raw/ is the provenance corpus and MUST be tracked (LFS for PDFs).
!data/raw/
!data/raw/**
