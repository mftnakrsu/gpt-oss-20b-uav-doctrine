data/clean/
data/chunked/
data/sft/
data/eval/
checkpoints/
outputs/
logs/
wandb/
*.ckpt

# --- Secrets ---
.env

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store

# --- Tooling state ---
.claude/

# --- Explicitly tracked ---
# data/raw/ is the provenance corpus and MUST be tracked (LFS for PDFs).
!data/raw/
!data/raw/**
