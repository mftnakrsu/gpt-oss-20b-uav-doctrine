# --- Python / build ---
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# --- Virtual envs / package managers ---
.venv/

# --- Project outputs (regenerable; never tracked) ---
data/interim/
data/processed/
