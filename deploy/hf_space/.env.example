# Credentials for the UAV Doctrine Assistant Space.
#
# LOCAL: copy to `.env` next to app.py and fill in the values.
# HF SPACES: do NOT commit a filled-in .env. Add these as Space Secrets under
#            Settings -> Variables and secrets (so they are never in git).

# REQUIRED. Both models (v4 adapter + un-adapted baseline) are served through
# Tinker's SamplingClient; the backend will not start without this.
TINKER_API_KEY=

# Likely required. Used to download the gated openai/gpt-oss-20b tokenizer that
# the gpt_oss_no_sysprompt renderer needs to build prompts.
HF_TOKEN=
